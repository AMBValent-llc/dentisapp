{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mediflow",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BETTER_AUTH_URL": "https://mediflow.accounts-865.workers.dev",
    "NEXT_PUBLIC_APP_URL": "https://mediflow.accounts-865.workers.dev"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  }
}
