{
  "name": "docli",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev-environment.ts --check && next dev",
    "dev:setup": "tsx scripts/dev-environment.ts --setup",
    "dev:setup:demo": "tsx scripts/dev-environment.ts --setup-demo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:upload": "npm run cf:build && opennextjs-cloudflare upload",
    "cf:preflight:staging": "tsx scripts/staging-deployment.ts --preflight",
    "cf:verify-access:staging": "tsx scripts/staging-deployment.ts --verify-access",
    "cf:verify:staging": "tsx scripts/staging-deployment.ts --verify",
    "cf:build:staging": "opennextjs-cloudflare build --env staging",
    "cf:deploy:staging": "npm run cf:preflight:staging && npm run cf:build:staging && opennextjs-cloudflare deploy --env staging",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts --apply",
    "db:deploy": "tsx scripts/migrate.ts --apply",
    "db:adopt": "tsx scripts/migrate.ts --adopt-prisma",
    "db:seed": "tsx scripts/seed.ts",
    "db:status": "tsx scripts/migrate.ts --check",
    "test": "tsx --test scripts/auth-flow.test.ts scripts/client-errors.test.ts scripts/demo-login.test.ts scripts/dev-environment.test.ts scripts/runtime-imports.test.ts scripts/search.test.ts scripts/staging-deployment.test.ts",
    "test:api": "tsx scripts/integration.ts",
    "test:api:isolated": "tsx scripts/run-isolated-api-tests.ts",
    "test:db": "tsx --test scripts/db-contract.test.ts",
    "test:roles": "tsx --test scripts/member-permissions.test.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.3",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "1.7.3",
    "drizzle-orm": "^0.45.2",
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@next/env": "15.5.25",
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.5.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "wrangler": "4.129.1"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
