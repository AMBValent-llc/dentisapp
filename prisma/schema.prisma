generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

generator cloudflareClient {
  provider = "prisma-client"
  output   = "../generated/prisma-cloudflare"
  runtime  = "cloudflare"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProcessStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ConsentStatus {
  DRAFT
  PENDING
  SIGNED
  REVOKED
}

enum ReferralStatus {
  DRAFT
  SENT
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum ExamStatus {
  ORDERED
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id            String            @id
  name          String
  email         String            @unique
  emailVerified Boolean           @default(false)
  image         String?
  phone         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  assignedTasks Task[]            @relation("TaskAssignee")
  createdTasks  Task[]            @relation("TaskCreator")
  documents     Document[]        @relation("DocumentUploader")
  histories     ClinicalHistory[] @relation("HistoryAuthor")
  consents      Consent[]         @relation("ConsentCreator")
  referrals     Referral[]        @relation("ReferralCreator")
  exams         Exam[]            @relation("ExamCreator")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Organization {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  sector      String?
  teamSize    String?
  plan        String            @default("starter")
  timezone    String            @default("America/Bogota")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships Membership[]
  processes   Process[]
  tasks       Task[]
  documents   Document[]
  patients    Patient[]
  histories   ClinicalHistory[]
  consents    Consent[]
  referrals   Referral[]
  exams       Exam[]
}

model Membership {
  id             String         @id @default(cuid())
  role           MembershipRole @default(MEMBER)
  userId         String
  organizationId String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Process {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  description    String?
  area           String?
  ownerName      String?
  status         ProcessStatus @default(DRAFT)
  priority       Priority      @default(MEDIUM)
  progress       Int           @default(0)
  dueDate        DateTime?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps          ProcessStep[]
  tasks          Task[]
  documents      Document[]

  @@index([organizationId, status])
  @@index([organizationId, name])
}

model ProcessStep {
  id          String   @id @default(cuid())
  processId   String
  title       String
  description String?
  position    Int
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  process     Process  @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@unique([processId, position])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  processId      String?
  assigneeId     String?
  createdById    String
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       Priority     @default(MEDIUM)
  progress       Int          @default(0)
  dueDate        DateTime?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process        Process?     @relation(fields: [processId], references: [id], onDelete: SetNull)
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy      User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([processId])
  @@index([assigneeId])
}

model Document {
  id             String       @id @default(cuid())
  organizationId String
  processId      String?
  uploadedById   String
  name           String
  description    String?
  mimeType       String?
  sizeBytes      Int?
  externalUrl    String?
  category       String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  process        Process?     @relation(fields: [processId], references: [id], onDelete: SetNull)
  uploadedBy     User         @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([processId])
}

model Patient {
  id             String            @id @default(cuid())
  organizationId String
  documentNumber String
  fullName       String
  birthDate      DateTime?
  sex            String?
  phone          String?
  email          String?
  address        String?
  city           String?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  histories      ClinicalHistory[]
  consents       Consent[]
  referrals      Referral[]
  exams          Exam[]

  @@unique([organizationId, documentNumber])
  @@index([organizationId, fullName])
}

model ClinicalHistory {
  id                 String       @id @default(cuid())
  organizationId     String
  patientId          String
  authorId           String
  consultationReason String
  currentIllness     String?
  personalHistory    String?
  familyHistory      String?
  currentMedication  String?
  examination        String?
  diagnosis          String?
  treatmentPlan      String?
  painScale          Int?
  metadata           Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient            Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  author             User         @relation("HistoryAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([patientId])
}

model Consent {
  id             String        @id @default(cuid())
  organizationId String
  patientId      String
  createdById    String
  title          String
  body           String?
  status         ConsentStatus @default(DRAFT)
  signedAt       DateTime?
  expiresAt      DateTime?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy      User          @relation("ConsentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([patientId])
}

model Referral {
  id             String         @id @default(cuid())
  organizationId String
  patientId      String
  createdById    String
  specialty      String
  provider       String?
  reason         String
  status         ReferralStatus @default(DRAFT)
  referredAt     DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy      User           @relation("ReferralCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([patientId])
}

model Exam {
  id             String       @id @default(cuid())
  organizationId String
  patientId      String
  createdById    String
  name           String
  type           String?
  status         ExamStatus   @default(ORDERED)
  orderedAt      DateTime     @default(now())
  scheduledAt    DateTime?
  completedAt    DateTime?
  result         String?
  notes          String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("ExamCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([patientId])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
