# Run `npm run dev:setup` to provision an isolated temporary Neon project and
# generate this file locally. Set these manually only for an existing dev project.
DATABASE_URL="postgresql://ROLE:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require"
BETTER_AUTH_SECRET="generate-with-npm-run-dev-setup"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ENABLE_DEMO_LOGIN="false"
DEMO_EMAIL=""
DEMO_PASSWORD=""
